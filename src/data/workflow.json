{
  "workflow_name": "AdmitOS_v2",
  "goal": "Turn a student into a strategically positioned, fully prepared, submission-ready Ivy/Top 30 applicant",
  "states": [
    {
      "id": "CASE_INTAKE",
      "name": "Case Intake and Positioning",
      "agents": [
        "PositioningAgent",
        "CaseManagerAgent"
      ],
      "tasks": [
        "collect_student_profile",
        "collect_academic_records",
        "collect_testing_status",
        "collect_family_budget",
        "collect_target_majors",
        "generate_positioning_report",
        "generate_initial_risk_assessment"
      ],
      "outputs": [
        "student_profile_snapshot",
        "positioning_report",
        "risk_score",
        "target_tier_recommendation"
      ],
      "next_states": [
        "ROADMAP_AND_SCHOOL_LIST"
      ]
    },
    {
      "id": "ROADMAP_AND_SCHOOL_LIST",
      "name": "Roadmap and Strategic School List",
      "agents": [
        "SchoolListAgent",
        "StrategyAgent"
      ],
      "tasks": [
        "generate_reach_match_likely_list",
        "assign_ed_ea_rd_strategy",
        "build_application_calendar",
        "build_backup_strategy"
      ],
      "outputs": [
        "school_list",
        "application_calendar",
        "strategy_memo"
      ],
      "next_states": [
        "TESTING_AND_ACADEMIC_SUPPORT",
        "EXTRACURRICULAR_PROFILE_BUILDING"
      ]
    },
    {
      "id": "TESTING_AND_ACADEMIC_SUPPORT",
      "name": "Testing and Academic Support",
      "agents": [
        "TestingAgent",
        "AcademicAgent"
      ],
      "tasks": [
        "decide_sat_act",
        "set_target_scores",
        "assign_diagnostic_test",
        "generate_study_plan",
        "route_to_tutor"
      ],
      "outputs": [
        "testing_plan",
        "academic_support_plan"
      ],
      "next_states": [
        "EXTRACURRICULAR_PROFILE_BUILDING"
      ]
    },
    {
      "id": "EXTRACURRICULAR_PROFILE_BUILDING",
      "name": "Extracurricular and Leadership Development",
      "agents": [
        "ProfileAgent"
      ],
      "tasks": [
        "audit_current_activities",
        "identify_profile_gaps",
        "recommend_honors_competitions",
        "recommend_summer_programs",
        "recommend_capstone_path"
      ],
      "outputs": [
        "activity_audit",
        "profile_building_plan"
      ],
      "next_states": [
        "RESEARCH_CAPSTONE_EXECUTION"
      ]
    },
    {
      "id": "RESEARCH_CAPSTONE_EXECUTION",
      "name": "Research / Capstone Execution",
      "agents": [
        "ResearchAgent"
      ],
      "tasks": [
        "select_project_type",
        "generate_scope",
        "assign_mentor",
        "track_deliverables",
        "capture_evidence"
      ],
      "outputs": [
        "project_scope",
        "research_deliverables"
      ],
      "next_states": [
        "ESSAY_AND_NARRATIVE_SYSTEM"
      ]
    },
    {
      "id": "ESSAY_AND_NARRATIVE_SYSTEM",
      "name": "Essay and Narrative System",
      "agents": [
        "EssayAgent",
        "NarrativeAgent"
      ],
      "tasks": [
        "generate_personal_statement_topics",
        "generate_supplement_matrix",
        "draft_essay_versions",
        "track_feedback_cycles",
        "check_narrative_consistency"
      ],
      "outputs": [
        "personal_statement",
        "supplement_essays",
        "narrative_consistency_report"
      ],
      "next_states": [
        "RECOMMENDATION_AND_SUPPORTING_DOCS"
      ]
    },
    {
      "id": "RECOMMENDATION_AND_SUPPORTING_DOCS",
      "name": "Recommendations and Supporting Documents",
      "agents": [
        "DocumentAgent"
      ],
      "tasks": [
        "select_recommenders",
        "generate_brag_sheet",
        "track_recommendation_deadlines",
        "assemble_resume"
      ],
      "outputs": [
        "brag_sheet",
        "resume",
        "recommendation_status"
      ],
      "next_states": [
        "APPLICATION_FINAL_REVIEW"
      ]
    },
    {
      "id": "APPLICATION_FINAL_REVIEW",
      "name": "Former Admissions Officer Review",
      "agents": [
        "ReviewAgent",
        "FAOA_Agent"
      ],
      "tasks": [
        "run_consistency_check",
        "generate_readiness_score",
        "route_to_human_fao",
        "simulate_feedback"
      ],
      "outputs": [
        "readiness_score",
        "fao_feedback_report"
      ],
      "next_states": [
        "SUBMISSION_AND_POST_SUBMISSION"
      ]
    },
    {
      "id": "SUBMISSION_AND_POST_SUBMISSION",
      "name": "Submission, Interview, Waitlist and Conversion",
      "agents": [
        "SubmissionAgent",
        "InterviewAgent"
      ],
      "tasks": [
        "approve_submission",
        "track_portals",
        "prepare_interview_pack",
        "generate_loci",
        "compare_offers"
      ],
      "outputs": [
        "submission_confirmation",
        "interview_prep_materials",
        "loci_draft",
        "final_decision_matrix"
      ],
      "next_states": []
    }
  ]
}
