# ─── UniOffer MVP — environment variables ──────────────────────────────────────
# Copy to .env.local and fill in. All values are validated at boot by lib/env.ts.
# Never commit .env.local. Rotate any leaked key immediately.

# ─── Public (client-safe) ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# PostHog (client analytics — product events only, NEVER wellbeing events)
NEXT_PUBLIC_POSTHOG_KEY=phc_...
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ─── Server-only ──────────────────────────────────────────────────────────────

# Supabase — we use the SAME project but THREE distinct service roles so that
# the middleware isolation guard can verify which service role is being used.
# Q3 default: single Supabase project + separate service roles + middleware guard
# (alternative: two Supabase projects — switch if Andy decides otherwise).
SUPABASE_SERVICE_ROLE_KEY_ADMISSIONS=eyJ...
SUPABASE_SERVICE_ROLE_KEY_WELLBEING=eyJ...
SUPABASE_SERVICE_ROLE_KEY_COMMONS=eyJ...

# Upstash Redis — backs BullMQ queues (cef_submitted, essay_uploaded, audit_alerts, adie_message)
UPSTASH_REDIS_REST_URL=https://<name>.upstash.io
UPSTASH_REDIS_REST_TOKEN=AX...
# Standard Redis URL for BullMQ (BullMQ cannot use the REST URL)
REDIS_URL=rediss://default:<token>@<host>:<port>

# Observability — 3-layer per Thread 4 mandatory systems
LANGSMITH_API_KEY=ls-...
LANGSMITH_PROJECT=unioffer-mvp
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

SENTRY_DSN=https://<key>@<ingest>.ingest.sentry.io/<project>
SENTRY_ORG=adropedu
SENTRY_PROJECT=unioffer-mvp
SENTRY_AUTH_TOKEN=sntrys_...

POSTHOG_API_KEY=phc_...
POSTHOG_HOST=https://eu.posthog.com

# LLM providers
ANTHROPIC_API_KEY=sk-ant-...
# DeepSeek is PERMANENTLY BANNED — do not add any DeepSeek key here.

# Auth
GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-...
NEXTAUTH_SECRET=<random 32+ bytes base64>

# CSRF — HMAC secret for signed double-submit token (lib/security/csrf.ts)
# Generate with: `openssl rand -base64 32`
CSRF_SECRET=<random 32+ bytes base64>

# Environment discriminator
APP_ENV=development
# One of: development | staging | production
