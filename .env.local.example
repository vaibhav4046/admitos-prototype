# ──────────────────────────────────────────────────────────────────────────────
#  UniOffer — local development boot stub.
#  Copy this file to `.env.local` (which is .gitignored) and replace every
#  PLACEHOLDER value with a real one before booting against any real backend.
#
#  This stub is good enough to satisfy the Zod schema in `lib/env.ts` so the
#  Next dev server, the workers, and `vitest` can all import `lib/env.ts`
#  without throwing. NONE of these placeholders work against real services —
#  using them will fail at the first real request, which is intentional:
#  we want loud failure, not silent fallback.
#
#  Generation tips for the secrets:
#    NEXTAUTH_SECRET / CSRF_SECRET:
#        openssl rand -base64 48
#    Supabase keys:
#        supabase projects api-keys --project-ref <ref>
#    Sentry DSN:
#        Sentry → Project Settings → Client Keys (DSN)
#    LangSmith key:
#        smith.langchain.com → Settings → API Keys
#    PostHog key:
#        eu.posthog.com → Project Settings → Project API Key
#
#  HARD RULE: NEVER add any DEEPSEEK_* variable. lib/env.ts will refuse to
#  boot if it sees one. DeepSeek is permanently banned.
# ──────────────────────────────────────────────────────────────────────────────

# ─── Public (client-safe) ─────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-replace-before-real-use-XXXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_placeholder_replace_before_real_use_XXXXXXXX
NEXT_PUBLIC_POSTHOG_HOST=https://eu.posthog.com

# ─── Server-only ──────────────────────────────────────────────────────────────
APP_ENV=development

SUPABASE_SERVICE_ROLE_KEY_ADMISSIONS=placeholder-service-role-admissions-XXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY_WELLBEING=placeholder-service-role-wellbeing-XXXXXXXXXXXX
SUPABASE_SERVICE_ROLE_KEY_COMMONS=placeholder-service-role-commons-XXXXXXXXXXXX

REDIS_URL=redis://localhost:6379
# UPSTASH_REDIS_REST_URL and _TOKEN are optional; leave blank for local Redis.

LANGSMITH_API_KEY=ls-placeholder-replace-before-real-use
LANGSMITH_PROJECT=unioffer-mvp
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0
SENTRY_ORG=adropedu
SENTRY_PROJECT=unioffer-mvp

POSTHOG_API_KEY=phc_placeholder_replace_before_real_use
POSTHOG_HOST=https://eu.posthog.com

ANTHROPIC_API_KEY=sk-ant-placeholder-replace-before-real-use-XXXXXXXX

GOOGLE_OAUTH_CLIENT_ID=placeholder.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-placeholder-replace-before-real-use

# Both must be ≥32 bytes. The values below are deterministic placeholders
# that satisfy the length check — REPLACE THEM before any non-local boot.
NEXTAUTH_SECRET=placeholder-nextauth-secret-replace-before-real-use-32+
CSRF_SECRET=placeholder-csrf-secret-replace-before-real-use-32+chars
