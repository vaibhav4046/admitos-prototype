{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "AdmitOS Full Stack (Frontend + Backend)",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000
    },
    {
      "name": "AdmitOS Frontend (Vite)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["vite", "--port=3000", "--host=0.0.0.0"],
      "port": 3000
    },
    {
      "name": "AdmitOS Backend (Express + Claude API)",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["tsx", "watch", "server.ts"],
      "port": 3001
    }
  ]
}
